VITE_API_URL=http://localhost:5000/api

# Optional: enables Google sign-in on login/register
# Get this from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Session expiry in days (should match JWT token expiry on backend)
VITE_SESSION_EXPIRY_DAYS=7
